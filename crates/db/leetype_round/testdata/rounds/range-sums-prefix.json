    "source": "pub fn range_sums(values: &[i64], queries: &[(usize, usize)]) -> Vec<i64> {\n    let mut out = Vec::new();\n    for &(l, r) in queries {\n        let mut total = 0;\n        for i in l..r {\n            total += values[i];\n        }\n        out.push(total);\n    }\n    out\n}\n",
