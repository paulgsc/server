# The rust-runner: Rust Rounds' sandboxed recorder (paulgsc/some-ui#2234,
# RR3). It compiles and runs programs a tutor wrote, which nobody reviewed,
# so every program is treated as hostile. The image is the toolchain plus one
# small binary; the sandbox is the container (infra/compose/rust_runner.yml):
# no network, a read-only root, a uid of its own, process, memory and CPU
# caps. The design and its invariants (EX1, RX1-RX4) are in
# apps/servers/file_host/docs/leetype-execution.md.
#
# Pinned to rustc 1.97.0 (2d8144b78 2026-07-07), the owner's own toolchain:
# rustc's messages change between versions, and every recording is keyed to
# the toolchain that made it (`rustc -V`), so a bump here re-keys every
# program and the next pass records them again. Not a floating `1.97`, which
# moved to 1.97.1 on 2026-07-14. scripts/check_rust_runner_sandbox.py checks
# the exact text this toolchain prints for the worked example.
FROM rust:1.97.0-slim-bookworm AS builder

WORKDIR /app

# Only what `cargo build -p rust_runner` needs to resolve the workspace:
# every manifest is read, but only this crate and its dependencies compile.
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY apps/ apps/

RUN cargo build --release --locked -p rust_runner --bin rust-runner \
    && strip target/release/rust-runner


# The same image as the builder: the runtime needs rustc and a linker (cc),
# which is what this image is. prlimit and setsid are util-linux, which is
# essential in Debian, so they are here too.
FROM rust:1.97.0-slim-bookworm

# The uid the runner has to itself. `--sweep-uid` kills every other process
# of it after each compile and run, which is only safe because nothing else
# in the container runs as it.
RUN groupadd --system --gid 10001 runner \
    && useradd --system --uid 10001 --gid runner --no-create-home --shell /usr/sbin/nologin runner \
    && ln -s "$(rustc --print sysroot)/bin/rustc" /usr/local/bin/rustc-pinned

COPY --from=builder /app/target/release/rust-runner /usr/local/bin/rust-runner

# rustc itself, not rustup's proxy, so a run never consults rustup's state.
# The runner forwards PATH and the rustup variables to rustc only, for the
# linker; a program's run gets no environment at all.
ENV RUST_RUNNER_RUSTC=/usr/local/bin/rustc-pinned \
    RUST_RUNNER_SOCKET=/run/rust-runner/runner.sock \
    RUST_RUNNER_WORK=/work \
    RUST_RUNNER_SWEEP_UID=true

USER runner

ENTRYPOINT ["/usr/local/bin/rust-runner"]
CMD ["serve"]
