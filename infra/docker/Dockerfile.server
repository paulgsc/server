# ── Stage 1: chef base ────────────────────────────────────────────────────
# Purpose:
#   - Provide a reusable Rust toolchain layer
#   - Install cargo-chef for dependency caching
#   - Install native build dependencies required by workspace crates
#
# This stage is shared by planner and builder to avoid duplication.
#
# Pinned, not `rustlang/rust:nightly-slim`: a floating tag moves daily, and
# every move invalidates every layer below it — cargo-chef's dependency layer
# included. Same version as lint.yml's clippy pin; bookworm to match the
# debian:12-slim runtime's glibc. Nothing in the workspace needs nightly (the
# one nightly-only thing was `-Z dylib-lto`, a no-op for a binary).
FROM rust:1.94.1-slim-bookworm AS chef

WORKDIR /app

# Install cargo-chef for dependency graph caching
RUN cargo install cargo-chef --locked

# Install system dependencies required for building the workspace
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    ca-certificates \
    build-essential \
    libasound2-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*


# ── Stage 2: planner ──────────────────────────────────────────────────────
# Purpose:
#   - Compute the dependency graph (recipe.json)
#   - This layer changes only when Cargo.toml / dependency structure changes
#
# Result:
#   - recipe.json describing all dependencies needed to build `file_host`
FROM chef AS planner

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY apps/ apps/

RUN cargo chef prepare --recipe-path recipe.json --bin file_host


# ── Stage 3: builder ──────────────────────────────────────────────────────
# Purpose:
#   - Build dependencies first (cacheable layer)
#   - Then build the actual binary
#
# Strategy:
#   1. Cook dependencies using recipe.json (stable cache layer)
#   2. Copy full source
#   3. Build only the target binary
FROM chef AS builder

# Step 1: build dependency layer. Nothing that varies per run may appear
# above this line — see VCS_REF/BUILD_DATE below.
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json

# Step 2: copy full source (invalidates only this layer on code changes)
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY apps/ apps/
COPY .sqlx/ .sqlx/
# Embedded by `schema::MIGRATOR` (sqlx::migrate!) so /ready can name
# migrations the runtime database hasn't applied yet.
COPY migrations/ migrations/

# Build configuration. Codegen flags live in the workspace's
# `[profile.release]`, not RUSTFLAGS here: RUSTFLAGS is part of every crate's
# fingerprint, so setting it only after cook made the final build recompile
# every dependency cook had just compiled.
ENV RUST_BACKTRACE=1
ENV RUST_LOG=info
ENV SQLX_OFFLINE=true

# Populated by CI via --build-arg (see .github/actions/docker-build). Not
# just OCI LABEL metadata (below) — apps/servers/file_host/build.rs reads
# these same names to stamp the `service_info` metric the binary itself
# reports (#213/F4), since `.git` isn't in this build context for it to
# derive them from directly. Defaulted so a local `docker build` with no
# --build-arg still produces a working, honestly-"unknown"-labelled image.
#
# Declared here, after cook, deliberately: BUILD_DATE differs on every run,
# and a changed ARG/ENV invalidates every layer after it. Above cook it made
# the dependency layer a guaranteed cache miss. Only file_host's own build.rs
# reads them, and file_host is compiled in the step below either way.
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ENV VCS_REF=${VCS_REF}
ENV BUILD_DATE=${BUILD_DATE}

# Step 3: build the binary.
# `-p` as well as `--bin`: `--bin` picks a target, not a package, so cargo
# still unifies features across every workspace member. The recipe (`prepare
# --bin`) holds only this binary's dependency closure, so cook resolves
# features for that closure alone, and without `-p` the two disagree:
# file_host's build recompiled 42 crates cook had built or skipped (obws and
# everything some-obs's `obs-websocket/websocket` feature touches).
RUN cargo build --release -p file_host --bin file_host

# Strip debug symbols to reduce binary size
RUN strip target/release/file_host


# ── Stage 4: runtime ──────────────────────────────────────────────────────
# Purpose:
#   - Provide a minimal runtime environment (glibc-based)
#   - Contain only the compiled binary + required shared libraries
#
# Notes:
#   - No Rust toolchain or source code is included
#   - Keeps image small and reduces attack surface
FROM debian:12-slim AS runtime

# Install only runtime dependencies (no build tools)
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libasound2 \
    libsqlite3-0 \
    libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && groupadd -g 10001 nonroot \
    && useradd -u 10000 -g nonroot -d /app -s /bin/bash nonroot

WORKDIR /app

# Create required runtime directories
RUN mkdir -p /app/data /app/config \
    && chown -R nonroot:nonroot /app

# Copy only the final binary from builder stage
COPY --from=builder --chown=nonroot:nonroot \
    /app/target/release/file_host /usr/local/bin/file_host

# Ensure executable
RUN chmod +x /usr/local/bin/file_host \
    && /usr/local/bin/file_host --version

USER nonroot:nonroot

# Runtime configuration
ENV RUST_LOG=info
ENV RUST_BACKTRACE=1
ENV DATA_DIR=/app/data

# Healthcheck endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/file_host", "--health-check"] || exit 1

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/file_host"]

# ── Metadata ──────────────────────────────────────────────────────────────
# Populated by CI at build time. ARGs don't cross the FROM boundary from the
# builder stage above, so VCS_REF/BUILD_DATE are declared again here — same
# --build-arg values, now labelling the image rather than feeding build.rs.
ARG APP_NAME=unknown
ARG BUILD_VERSION=unknown
ARG BUILD_DATE=unknown
ARG VCS_REF=unknown

LABEL org.opencontainers.image.title="${APP_NAME}" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/paulgsc/server"
