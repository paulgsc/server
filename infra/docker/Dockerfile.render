# Home's render worker (GWB10, paulgsc/some-ui#2084), with the weekly call's
# job (ST36, paulgsc/some-ui#2635) and Playoff Delta's (FEED4,
# paulgsc/some-ui#2647): infra/render/render-calls.sh.
#
# Everything that decides a video's bytes is pinned, so the same episode gives
# the same video:
# - Node and Chromium: Playwright's image for the version paulgsc/some-ui pins
#   (@playwright/test 1.62.1), by digest;
# - ffmpeg: Ubuntu noble's, from that image's apt sources;
# - the recorders and renderer: paulgsc/some-ui at SOME_UI_COMMIT. Bump it when
#   a recorder or the renderer changes, as call-stage's pin is bumped when its
#   stage does;
# - the motion, HyperFrames compositions (HYPER1, paulgsc/some-ui#2724):
#   paulgsc/some-ui at MOTION_COMMIT, its own checkout, so the motion moves
#   without moving the recorders away from call-stage's pin.
#
# The image builds only what the recorders and the motion need
# (@some-ui/video-render, @some-ui/playoff-delta, @some-ui/video-motion and
# their dependencies), never the app: the stage is the published image.
# `record:playoff-delta` imports @some-ui/playoff-delta's `recording` entry,
# which exists only once that package is built.
FROM mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e

# paulgsc/some-ui e6fd9c2 (#2797's merge, the commit www 0.1.62 was published
# from, so the recorders and call-stage's pin are one version again). It
# carries HYPER5 (#2799): the call's template v4 and Playoff Delta's v4, whose
# brand open and close are the composition `brand-v1`, drawn by the recorders
# themselves through @some-ui/video-motion's `installedCompositionPort` in
# Playwright's headless shell (found under PLAYWRIGHT_BROWSERS_PATH, which this
# image sets to /ms-playwright), with its work in a `draw-` folder beside the
# video under /renders. And VS1 (#2798): each stage refuses a template version
# newer than it knows, so a recorder newer than its stage fails loudly instead
# of drawing a week in the old look; the two pins still move together. Also
# v3's Mochi Night (SFEED10, #2774), `record:preview` (SFEED12, #2781), and
# captions (SFEED11, #2707) recorded a scene at a time from `/burn-ins?record`.
ARG SOME_UI_COMMIT=e6fd9c271204451534a533d7cf728563b1d0e807

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none https://github.com/paulgsc/some-ui.git /opt/some-ui \
    && git -C /opt/some-ui checkout --detach "$SOME_UI_COMMIT"

WORKDIR /opt/some-ui
RUN corepack enable \
    && pnpm install --frozen-lockfile --filter "www..." \
    && pnpm exec turbo run build --filter="@some-ui/video-render^..." \
       --filter="@some-ui/playoff-delta..."

# paulgsc/some-ui e6fd9c2, SOME_UI_COMMIT's (HYPER4 #2790, HYPER5 #2799):
# @some-ui/video-motion, the compositions and their pinned HyperFrames, with
# fonts from the lockfile, so a render reaches no network, plus `motion walk` and `motion promo`, whose
# sound cues come from `--brand` (home's ${STORAGE}/brand, mounted at /brand). A
# worktree of the clone above, at its own commit, fetched first, since a cached
# clone may predate it. Compositions draw in Playwright's headless shell, which
# this image carries, through a wrapper written into the render's work folder,
# so /renders must not be mounted noexec (motion refuses otherwise).
#
# Measured on this image with call-render.yml's limits (--memory 4g --cpus 2,
# no network, uid 10000, root read-only), 2026-11-08, on #2743: the sample
# composition (2 s, 60 frames at 1080x1920) takes about 10 s a render, and
# Suspender Ledger 0.3.1's promo (15.8 s) about 158 s, peaking at 821 MB, each
# the same bytes twice. The recorders' own checkout (/opt/some-ui, where
# `installedCompositionPort` is imported from) draws v4's `brand-v1` the same
# way: about 9 s a render, the same bytes twice (2026-11-08, at de273ce). On
# home, through tsx as render-calls.sh runs the recorders:
#
#   make compose ARGS="run --rm --no-deps -w /opt/some-ui-motion/packages/video-motion \
#     --entrypoint node_modules/.bin/tsx render src/cli.ts prove sample --work /renders"
ARG MOTION_COMMIT=e6fd9c271204451534a533d7cf728563b1d0e807

RUN git -C /opt/some-ui fetch --filter=blob:none origin "$MOTION_COMMIT" \
    && git -C /opt/some-ui worktree add --detach /opt/some-ui-motion "$MOTION_COMMIT" \
    && pnpm -C /opt/some-ui-motion install --frozen-lockfile --filter "@some-ui/video-motion..." \
    && pnpm -C /opt/some-ui-motion exec turbo run build --filter="@some-ui/video-motion^..."

COPY infra/render/render-calls.sh /usr/local/bin/render-calls

# The root is read-only at run time (call-render.yml); tsx and the renderer
# write only under /tmp.
ENV HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    TSX_CACHE_DIR=/tmp/tsx

ENTRYPOINT ["/usr/local/bin/render-calls"]
