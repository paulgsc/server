      "title": "Home reading the mailbox",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Whether this home reads the Jobs mailbox at all (MAILBOX_ENABLED). OFF is a choice, not a fault.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "#8E8E8E",
                  "text": "OFF"
                },
                "1": {
                  "color": "green",
                  "text": "ON"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "#8E8E8E",
                  "text": "no data"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "mailbox_poll_enabled",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "READING",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Intervals since the poller last started a pass. Above 2, it has stopped asking: the task died or a pass hangs.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "mappings": [
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "#8E8E8E",
                  "text": "no data"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "(time() - mailbox_poll_last_attempt_timestamp_seconds) / mailbox_poll_interval_seconds",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "SINCE LAST READ",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
