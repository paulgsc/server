      "description": "The last run's verdict. GOOD: both units succeeded, the system and the home profile are both on main, and the capture worked. The CHECKS panel says which part failed; the upgrade-log issue says why.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "NOT GOOD"
                },
                "1": {
                  "color": "green",
                  "text": "GOOD"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "#8E8E8E",
                  "text": "no data"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8E8E8E",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
