  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "High load average + Low CPU usage = I/O bound hang",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "text": "System Healthy"
                },
                "1": {
                  "color": "red",
                  "text": "🚨 I/O HANG DETECTED!"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "#8E8E8E",
                  "text": "no data"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "textSize": {
          "title": 16,
          "value": 14
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(\n  (node_load1 / count without(cpu, mode) (node_cpu_seconds_total{mode=\"idle\"})) > 3\n)\nand\n(\n  (100 - avg without(cpu, mode) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100) < 30\n)\n",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "🚨 SYSTEM HANG DETECTOR",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Processes stuck in uninterruptible sleep (I/O wait)",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "#8E8E8E",
                  "text": "no data"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_procs_blocked",
          "refId": "A"
        }
      ],
      "title": "Processes in D State",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Processes consuming most CPU — file-host in blue",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Process Group"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*file-host.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "id": 4,
      "options": {
        "frameIndex": 0,
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "CPU %"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(15,\n  sum by (groupname) (\n    rate(namedprocess_namegroup_cpu_seconds_total{groupname!=\"\"}[1m])\n  ) * 100\n)\n",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "👤 TOP CPU OFFENDERS (% of 1 core)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value": "CPU %",
              "groupname": "Process Group"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
