{
  "binary": "some-obs",
  "about": "OBS automation application",
  "variables": [
    {
      "name": "NATS_URL",
      "group": "NATS",
      "required": true,
      "default": null,
      "kind": "string",
      "values": [],
      "delimiter": null,
      "secret": false,
      "help": "The NATS server to connect to.\n\nRequired: no address is right on every host (#617). Compose's services set theirs; `make dev` takes its role's.",
      "required_when": null,
      "bounds": null
    },
    {
      "name": "OBS_HOST",
      "group": "OBS",
      "required": false,
      "default": "10.0.0.25",
      "kind": "string",
      "values": [],
      "delimiter": null,
      "secret": false,
      "help": "obs-websocket's host",
      "required_when": null,
      "bounds": null
    },
    {
      "name": "OBS_PORT",
      "group": "OBS",
      "required": false,
      "default": "4455",
      "kind": "u16",
      "values": [],
      "delimiter": null,
      "secret": false,
      "help": "obs-websocket's port",
      "required_when": null,
      "bounds": null
    },
    {
      "name": "OBS_PASSWORD",
      "group": "OBS",
      "required": false,
      "default": null,
      "kind": "string",
      "values": [],
      "delimiter": null,
      "secret": true,
      "help": "obs-websocket's server password. Empty means OBS has authentication off",
      "required_when": null,
      "bounds": null
    },
    {
      "name": "RUST_LOG",
      "group": "Logging",
      "required": false,
      "default": "some_obs=info,obs_websocket=info,some_shutdown=info",
      "kind": "string",
      "values": [],
      "delimiter": null,
      "secret": false,
      "help": "`tracing` filter directives, e.g. `info,async_nats=warn`.\n\nA filter that does not parse stops the binary at start.",
      "required_when": null,
      "bounds": null
    }
  ]
}
