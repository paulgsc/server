
file_host.nixos.local {
    tls internal  # Use Caddy's internal CA for local development
    # `file-host` is a Swarm service VIP in production.  During a start-first
    # rolling update the VIP keeps the old tasks in rotation until their
    # replacements have passed the container health check.  Caddy adds an
    # application-level readiness check and retries another task if the one
    # selected by the VIP disappears between requests.
    reverse_proxy file-host:3000 {
        health_uri /ready
        health_interval 5s
        health_timeout 3s
        lb_try_duration 5s
        lb_try_interval 250ms

        # Do not buffer WebSocket traffic. Existing upgraded connections stay
        # attached to a draining task while new handshakes use a ready task.
        flush_interval -1
    }
}
