###############################################
#   GENERATED: do not edit this file by hand
###############################################
# `make env-schema` writes it from each binary's clap Config (checked in as
# infra/env/<binary>.json) and the compose files' ${...} variables, with the
# header in infra/env/example.env.head. CI fails when it differs. To change a
# variable's help or default, change it where it is declared and regenerate.
# `make env` lists every variable and which ones your .env sets; `make
# preflight` checks .env before `docker compose up`.

###############################################
#        WHO READS THIS FILE, AND HOW
###############################################
# Copy to `.env` at the repo root, set DEPLOY and the secrets, then `make
# preflight`. This file holds what stays off git: the secrets, the neutral
# overrides (a default that surprises no one, changed on one host), and what
# docker compose itself reads. Every "ours" setting, one that decides how our
# apps behave, is decided in git instead, per host and per app, in
# deploy/<role>/<binary>.env, in the PR that needs it; the preflight refuses
# one set here (CFG9, #604). Three things read this file:
#
#   docker compose  interpolates every ${...} in the compose files from it
#             (the "docker compose" section at the end), so a required one
#             missing stops every service, not only the one that uses it.
#             DEPLOY picks the deployment files: `home` on the box.
#
#   prod      each container takes its deployment file whole
#             (deploy/${DEPLOY}/<binary>.env, `env_file`), and from this
#             file only the names its compose `environment:` passes: its
#             secrets and its neutral variables. The container SETS its
#             wiring itself (DATABASE_URL, NATS_URL, REDIS_URL, RUST_LOG's
#             default, TOKIO_WORKER_THREADS), over both. file_host always
#             listens on 3000 (published on 127.0.0.1:3000 only; the LAN
#             reaches it through the host's Caddy, file-host.home).
#
#   make dev  file_host from source (`cargo run`), beside the container. It
#             takes deploy/dev/file_host.env, its own database and every
#             acting feature off, then this file (dotenvy) for the secrets;
#             anything already in the environment wins over both, so
#             `FOO=bar make dev` overrides one value for one run. It takes
#             the next free port from 3000 (FILE_HOST_PORT_FALLBACK).
#
# Each variable below is listed once, under the first binary that reads it,
# with its help and its default; `<binary> --help` says the same. Every line
# is commented out and shows the default: uncomment one to set it. A copy of
# this file sets nothing, so `make preflight` names each required variable
# until it is set. Unset and empty differ: `NAME=""` is set, to nothing.
#
# HOST-SPECIFIC: values marked so are right only on the nixos.local dev host
# (its /mnt/storage paths, this checkout's location). Any other host - a VPS,
# say - must set every one of them, and gets a deploy/<role>/ of its own:
#     grep -n HOST-SPECIFIC example.env
# file_host also warns at startup about each such default it is running on.
# See README.md, "Host-specific values", and #406.

###############################################
#   file_host
###############################################
# File hosting server.
# Decided per host in deploy/<role>/file_host.env, never here (CFG9, #604),
# and the preflight refuses one set in .env: ALLOWED_ORIGINS, REDIS_URL,
# DATABASE_URL, NUDGE_ENABLED, VAPID_PUBLIC_KEY, VAPID_SUBJECT,
# NUDGE_TIMEZONE, NUDGE_QUIET_HOURS_START, NUDGE_QUIET_HOURS_END,
# RECOMMENDER_USES_OUTCOMES, APP_BASE_URL, AUTH_ENABLED, WEBAUTHN_RP_ID,
# WEBAUTHN_ORIGINS, AUTH_SESSION_DAYS, AUTH_OPEN_SIGNUP,
# AUTH_NEW_ACCOUNTS_PER_DAY, MAILBOX_ENABLED, ROUTINE_SCHEDULE,
# MAILBOX_ARCHIVE_DAYS, FCM_SERVICE_ACCOUNT_FILE, TRANSCRIBE_ENABLED,
# TRANSCRIBE_MODEL, RUST_ROUNDS_ENABLED, GAME_FEED_ENABLED, NATS_URL,
# ENVIRONMENT.

# ── Server ──

# Max number of concurrent fetches to deduplicate. Older entries are evicted
# when exceeded
# MAX_IN_FLIGHT="256"

# Address to listen on.
#
# `FILE_HOST_BIND`, not `HOST`: zsh exports `HOST` as the machine's name.
# These two were once `HOST`/`PORT` and read by nothing (the listener was
# hard-coded to `0.0.0.0:3000`); the defaults are that address, so honouring
# them changes nothing for a server started without them.
# FILE_HOST_BIND="0.0.0.0"

# Port to listen on.
#
# `FILE_HOST_PORT`, not `PORT`: the container reads the repo's `.env`, and a
# bare `PORT` there meant for another service would move this one.
# FILE_HOST_PORT="3000"

# Dev only: when the port is taken, listen on the next free one instead of
# failing (`listen::bind`). `make dev` sets it, so a server run from source
# can sit beside the production container. Never set it in production: its
# published port and healthcheck assume `FILE_HOST_PORT`
# true or false.
# FILE_HOST_PORT_FALLBACK="false"

# Where to record the port actually listened on, as `{ port, pid }`, for
# `paulgsc/some-ui`'s `vite dev` to find (`listen::PortFile`). Removed on
# shutdown. `make dev` sets it
# FILE_HOST_PORT_FILE=""

# Rate limit, in requests per minute, per client (`main.rs`'s
# `rate_limit_middleware` partitions by peer IP). See #215/#231: this field
# previously declared the right unit but was unread — the limiter's capacity
# was `max_request_size` (megabytes of upload payload) instead
# RATE_LIMIT="60"

# Cache TTL in seconds
# CACHE_TTL="600"

# Individual request payload lmit in MB
# MAX_REQUEST_SIZE_MB="10"

# Active request limit
# MAX_CONCURRENT_REQUESTS="100"

# Hard timeout for any operation
# TASK_TIMEOUT_MS="15000"

# ── Study nudge ──

# VAPID private key, base64url, the raw 32-byte P-256 scalar. Secret
# Required while NUDGE_ENABLED is true. Secret: keep it out of the repository.
# VAPID_PRIVATE_KEY=""

# How often the waker picks up work the engine already decided.
#
# Not a schedule. Eligibility instants are solved when signals arrive and
# written to an index; this is the resolution at which they are noticed, so
# shortening it lands interventions closer to their computed instant without
# changing which ones happen.
# NUDGE_WAKER_SECONDS="300"

# How long one push delivery may take before it counts as a failure (#264,
# SLI3).
#
# A push service that accepts answers in well under a second; one that has not
# answered in ten is not going to, and every second past that is a second the
# rest of the batch waits in the serial loop. Long enough that a
# slow-but-working provider on a bad day is not misread as down, short enough
# that one black-holed endpoint costs a pass seconds rather than the
# transport's own (unbounded) patience. A timed-out delivery is recorded as a
# failure — never a prune, never `Accepted` — and does not hand the claim
# back: see `nudge::waker::actuate`.
# PUSH_DELIVERY_TIMEOUT_MS="10000"

# How long one waker pass may run before it stops taking on new subjects
# (#264, SLI3).
#
# Two minutes: well inside `NUDGE_WAKER_SECONDS`' default of five, so a pass
# that hits it still leaves the next tick to start on time rather than be
# delayed by `MissedTickBehavior::Delay`, and long enough for a full `BATCH`
# of 32 subjects at typical sub-second delivery latency to finish many times
# over. A pass that runs out starts no further subject and tries no further
# device — each delivery's timeout is also capped at what the pass has left —
# but never cancels a subject part-way, so a claim already written stands.
# Subjects it did not reach are still due on the next pass, the property
# `BATCH` already relies on.
# WAKER_PASS_DEADLINE_MS="120000"

# How long a client-written presence lease stays fresh before a due subject's
# notification is sent as though nobody were looking.
#
# Renamed from `NUDGE_PRESENCE_FRESHNESS_SECONDS` (default `120`) when
# presence stopped being a WebSocket connection's staleness window and became
# a lease TTL: same shape of question, a different mechanism underneath, and a
# smaller default — a client renewing roughly every 45s while visible only
# needs a TTL wide enough to absorb timer throttling and scheduling jitter,
# not two minutes of slack.
# NUDGE_PRESENCE_LEASE_TTL_SECONDS="75"

# ── Passkey auth ──

# Comma-separated subject ids allowed to use the operator routes: the ones
# that rewrite, retire and restore what everyone is served (lessons, `leetype`
# rounds). Whitespace around an entry is trimmed and empty entries are
# ignored. Unset or empty, the owner's account (the only one) is the operator,
# and nobody is while the box has no account or several. Set, only the listed
# subjects are: an override for a deployment with `AUTH_OPEN_SIGNUP` on; see
# `auth::operator`.
#
# To find a subject id to list, sign in where you operate from and call any
# operator route: the refusal is logged at info with your `subject=`.
# A list, separated by ','. Private: it names an account or a person, so it
# stays out of the repository (CFG11, #607, commits it encrypted).
# OPERATOR_SUBJECTS=""

# ── Jobs mailbox ──

# The mailbox's base URL: `https://` and a host, no path
# (`https://some-ui-mailbox.<account>.workers.dev`)
# Required while MAILBOX_ENABLED is true. Private: it names an account or a
# person, so it stays out of the repository (CFG11, #607, commits it
# encrypted).
# MAILBOX_URL=""

# Home's own mailbox token: it reads `brief` and puts `decisions` and `scout`.
# Never logged
# Required while MAILBOX_ENABLED is true. Secret: keep it out of the
# repository.
# MAILBOX_TOKEN=""

# The subject whose copy the mailbox's files are kept as. Unset, the owner's
# account (the only one), read at each pass; while the box has no account or
# several, a pass keeps nothing and says `no_account`. Set, that subject: an
# override for a deployment with `AUTH_OPEN_SIGNUP` on, its id found as for
# `OPERATOR_SUBJECTS`
# Private: it names an account or a person, so it stays out of the repository
# (CFG11, #607, commits it encrypted).
# MAILBOX_SUBJECT=""

# Seconds between reads of the mailbox. At least 60
# At least 60 while MAILBOX_ENABLED is true.
# MAILBOX_SECONDS="900"

# Home's second mailbox token (the Worker's `ARCHIVE_TOKEN`): it moves a file
# live there long enough home, and puts one back when the routine asks. Unset,
# nothing is archived. Never logged
# Secret: keep it out of the repository.
# MAILBOX_ARCHIVE_TOKEN=""

# ── Voice-note transcription ──

# The Silero VAD model that finds a note's speech, mounted beside it
# TRANSCRIBE_VAD_MODEL="/models/ggml-silero-v5.1.2.bin"

# Threads one note is heard with. Unset, one fewer than the cores the
# container may use, and at least one
# At least 1 while TRANSCRIBE_ENABLED is true.
# TRANSCRIBE_THREADS=""

# Seconds one note may take, decoding included. At least 60
# At least 60 while TRANSCRIBE_ENABLED is true.
# TRANSCRIBE_DEADLINE_SECONDS="600"

# Seconds between looks for notes to hear. At least 10
# At least 10 while TRANSCRIBE_ENABLED is true.
# TRANSCRIBE_SECONDS="60"

# ── Rust Rounds recording ──

# The rust-runner's socket, as a path inside the container: where
# `infra/compose/rust_runner.yml`'s socket volume is mounted
# RUST_ROUNDS_SOCKET="/run/rust-runner/runner.sock"

# Seconds between looks for programs to record. At least 10
# RUST_ROUNDS_SECONDS="60"

# Seconds one pass may take, every program it records included. At least 142:
# the toolchain ask's wait and one program's, which outlasts the runner's job
# deadline
# RUST_ROUNDS_PASS_DEADLINE_SECONDS="600"

# ── NFL game feed ──

# Seconds between reads of the week's scoreboard. At least 60
# From 60 to 86400 while GAME_FEED_ENABLED is true.
# GAME_FEED_SCOREBOARD_SECONDS="600"

# Seconds between reads of a live game's play-by-play. At least 5
# From 5 to 86400 while GAME_FEED_ENABLED is true.
# GAME_FEED_LIVE_SECONDS="15"

# The longest a refused or failed fetch waits before the next try. At least
# both cadences above, and at most 86400 (a day)
# At most 86400 while GAME_FEED_ENABLED is true.
# GAME_FEED_BACKOFF_CAP_SECONDS="900"

# ── Logging ──

# `tracing` filter directives, e.g. `info,async_nats=warn`.
#
# A filter that does not parse stops the binary at start.
# Also read by orchestrator, some-obs (default
# some_obs=info,obs_websocket=info,some_shutdown=info). docker compose also
# reads it: infra/compose/file_host.yml, infra/compose/orchestrator.yml
# (default info,async_nats=warn).
# RUST_LOG="info"

# ── Tracing ──

# The OTLP (gRPC) collector traces are exported to, e.g.
# `http://otel-collector:4317`. Unset, they are not exported at all: nothing
# in the compose stack runs a collector, and metrics go through Prometheus
# (#139, #407)
# OTEL_EXPORTER_OTLP_ENDPOINT=""

# Which traces are kept: all (`always_on`), none (`always_off`), or the share
# `OTEL_TRACES_SAMPLER_ARG` names (`traceidratio`)
# One of: always_on, always_off, traceidratio.
# OTEL_TRACES_SAMPLER="traceidratio"

# With `traceidratio`, the share of traces kept, from 0 to 1
# From 0 to 1.
# OTEL_TRACES_SAMPLER_ARG="1"

# The `service.name` traces are exported under. Leave it unset: it defaults to
# the binary's own name, and a value in a `.env` that more than one binary
# loads renames all of their traces
# OTEL_SERVICE_NAME="file_host"

###############################################
#   orchestrator
###############################################
# Service orchestration application.
# Decided per host in deploy/<role>/orchestrator.env, never here (CFG9, #604),
# and the preflight refuses one set in .env: NATS_URL.
# Also reads RUST_LOG, listed above.

# Where the Prometheus `/metrics` listener binds.
#
# Orchestrator has no other HTTP surface (#143 (C1)) — this listener exists
# purely to be scraped. All interfaces, so it's reachable from
# `monitoring-network`, but `infra/compose/orchestrator.yml` deliberately
# publishes no port to the host, and this must not change that.
# METRICS_ADDR="0.0.0.0:9464"

###############################################
#   some-obs
###############################################
# OBS automation application.
# Not set here, as "ours" (CFG9, #604): NATS_URL, OBS_HOST. No deploy/<role>/
# holds some-obs yet, so they are set where it is deployed.
# Also reads RUST_LOG, listed above.

# ── OBS ──

# obs-websocket's port
# OBS_PORT="4455"

# obs-websocket's server password. Empty means OBS has authentication off
# Secret: keep it out of the repository.
# OBS_PASSWORD=""

# Seconds between checks that OBS is still connected. At least 1
# At least 1.
# HEALTH_CHECK_INTERVAL_SECS="30"

# ── Service ──

# Seconds the service's tasks get to finish once it is told to stop
# SHUTDOWN_TIMEOUT_SECS="10"

###############################################
#   docker compose
###############################################
# Read by docker compose itself, when it reads the compose files, not by
# a binary. Shell variables win over these lines.

# Read in infra/compose/analytics.yml.
# DATABASES_DIR="/mnt/storage/users/dev/databases"

# DEPLOY: the deploy/ role this host runs, `home` on the box. Each
# container takes deploy/<role>/<binary>.env; `make dev` takes
# deploy/dev/ itself, without compose.
# Required: every service waits on it. Read in infra/compose/file_host.yml,
# infra/compose/orchestrator.yml.
# DEPLOY=""

# Where the "file_host reported ERROR-level events" alert goes
# (infra/grafana/provisioning/alerting/file-host-errors.yml): a Slack
# incoming webhook's full URL, for the operator-owned alert channel.
# Unset, a placeholder that cannot deliver, so Grafana still starts and
# evaluates the rule.
#
# Grafana treats an empty Slack webhook URL as Slack Web API mode and
# then refuses to provision this contact point without a recipient.
# The fallback must also have Slack's incoming-webhook URL shape;
# otherwise Grafana classifies it as Slack Web API mode and still
# requires a recipient. These placeholder path segments cannot deliver.
# Read in infra/compose/monitoring.yml.
# FILE_HOST_ALERT_SLACK_WEBHOOK_URL="https://hooks.slack.com/services/NOT_CONFIGURED/NOT_CONFIGURED/NOT_CONFIGURED"

# Read in infra/compose/monitoring.yml.
# GRAFANA_ADMIN_PASSWORD="admin123"

# The address browsers use, for links, redirects and the login page;
# without it Grafana builds them from its own :3000.
# Read in infra/compose/monitoring.yml.
# GRAFANA_ROOT_URL="https://grafana.home.maishatu.com/"

# METABASE_DATA_DIR: where Metabase keeps its own database, and
# Read in infra/compose/analytics.yml.
# METABASE_DATA_DIR="/mnt/storage/users/dev/metabase-data"

# The address browsers use, for links in emails, embeds and exports.
# Read in infra/compose/analytics.yml.
# METABASE_SITE_URL="https://metabase.home.maishatu.com"

# Read in infra/compose/ollama.yml.
# OLLAMA_HOST_PORT="11434"

# OLLAMA_MODELS_PATH: the host directory of Ollama's models, mounted
# here (e.g. /mnt/ssd/ollama-models). HOST-SPECIFIC default: the
# nixos.local dev host's storage mount (#406); another host sets it.
# Read in infra/compose/ollama.yml.
# OLLAMA_MODELS_PATH="/mnt/storage/users/dev/models/ollama-models"

# Read in infra/compose/file_host.yml.
# POLARS_MAX_THREADS="4"

# REPO_ROOT: this checkout's absolute path. Every service mounts files
# from under it; required, because with it unset /data, /config and
# /logs were bind-mounted from the host's root (#407). HOST-SPECIFIC:
# wherever the checkout is.
# Required: every service waits on it. Read in infra/compose/nats.yml,
# infra/compose/file_host.yml, infra/compose/orchestrator.yml,
# infra/compose/monitoring.yml.
# REPO_ROOT=""

# STORAGE: the host directory holding file_host's SQLite database, mounted
# at /app/dbs (DATABASE_URL above). HOST-SPECIFIC default: the nixos.local
# dev host's storage mount (#406); another host sets STORAGE.
# Read in infra/compose/file_host.yml.
# STORAGE="/mnt/storage/users/dev/databases/hopium"

# Read in infra/compose/file_host.yml, infra/compose/orchestrator.yml.
# TOKIO_WORKER_THREADS="4"

# The voice-note transcriber's models, read-only: the multilingual
# Whisper model and the Silero VAD model `nix/whisper-manager`'s
# `whisper fetch` downloads. TRANSCRIBE_MODEL and TRANSCRIBE_VAD_MODEL
# default to these under /models. HOST-SPECIFIC default: the
# nixos.local dev host's models directory (#406); another host sets
# TRANSCRIBE_MODELS_DIR.
# Read in infra/compose/file_host.yml.
# TRANSCRIBE_MODELS_DIR="/mnt/storage/users/dev/models/whisper-models"
