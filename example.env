###############################################
#                SECURITY KEYS
###############################################

# HMAC signing key for JWTs or internal services
HMAC_KEY="CHANGE_ME_HMAC_KEY"

# OAuth client secret (Google, GitHub, etc.)
CLIENT_SECRET_FILE="./client_secret_file.json"

# Token for GitHub API usage
GITHUB_API_TOKEN="REPLACE_WITH_YOUR_GITHUB_PAT"

###############################################
#                    CORS
###############################################

# Comma-separated list of allowed origins for file_host's browser-facing routes
# (sheets, audio, tabs, mood_events, sessions, push).
#
# Note the ports. `:6006` is Storybook, not the study app. Service workers,
# Notification, and PushManager are all gated on a *secure context* — plain
# http://nixos.local does not qualify, and the APIs are simply absent from
# `window` rather than throwing — so a push subscription is always posted from
# an HTTPS origin, and the list has to admit it.
ALLOWED_ORIGINS="https://nixos.local:5173,https://localhost:5173,http://nixos.local:6006"

###############################################
#                   EMAIL
###############################################

# Email / notification service target address or API endpoint
EMAIL_SERVICE_URL="your_email@example.com"

###############################################
#                   OBS
###############################################

# OBS WebSocket connection
OBS_WEBSOCKET_PWD="CHANGE_ME_OBS_PASSWORD"
OBS_WEBSOCKET_IP="127.0.0.1"

###############################################
#                   PROJECT
###############################################

# Root directory of your monorepo/server
REPO_ROOT="/home/paulg/dev/server"

###############################################
#                   STORAGE
###############################################

# Where your app stores data
STORAGE="/mnt/storage/users/dev/databases/hopium"

# SQLite database location
DATABASE_URL="sqlite://${STORAGE}/hopium.db"

###############################################
#                  AUDIO I/O
###############################################

# ALSA device identifiers
AUDIO_DEVICE_NAME="hw:0,0"
AUDIO_DEVICE_INDEX=2

###############################################
#            Whisper Model Loading
###############################################

# Path **on host** to the Whisper model file
WHISPER_MODELS_PATH="/mnt/storage/users/dev/models/whisper-models/ggml-base.en-q5_1.bin"

# Path **inside container** (if using Docker)
WHISPER_MODEL="/models/ggml-base.en-q5_1.bin"

# Number of threads Whisper uses
WHISPER_THREADS=2

# Audio buffer duration in seconds (lower = more accurate = more CPU)
BUFFER_DURATION=3

###############################################
#                  NATS
###############################################

NATS_URL="nats://localhost:4222"

###############################################
#                OpenTelemetry
###############################################

OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4317"
OTEL_SERVICE_NAME="transcriber"

###############################################
#                  LOGGING
###############################################

# Global log level
RUST_LOG=info,async_nats=warn,orchestrator=info,file_host=debug

###############################################
#         OPTIONAL: PERFORMANCE PROFILES
###############################################

# --- Tiny Model (very low CPU) ---
# WHISPER_MODEL="/models/ggml-tiny.en-q5_1.bin"
# WHISPER_THREADS=1
# BUFFER_DURATION=5

# --- Balanced (recommended) ---
# WHISPER_MODEL="/models/ggml-base.en-q5_1.bin"
# WHISPER_THREADS=2
# BUFFER_DURATION=3

# --- Small Model (better accuracy) ---
# WHISPER_MODEL="/models/ggml-small.en-q5_1.bin"
# WHISPER_THREADS=3
# BUFFER_DURATION=4

# --- Medium Model (not recommended on 4-core CPU) ---
# WHISPER_MODEL="/models/ggml-medium.en-q5_1.bin"
# WHISPER_THREADS=3
# BUFFER_DURATION=5

###############################################
#                STUDY NUDGE
###############################################
# The daily "your session is ready" push notification.
# Full setup, key custody, and the migration story: docs/study-nudge.md

# Master switch for the engagement waker. With this false the /api/v1/push and
# /api/v1/signals routes still work — a browser can subscribe, signals still
# accumulate, and POST /api/v1/push/test still sends — but nothing is actuated
# on its own.
#
# When this is true, file_host REFUSES TO START without a usable VAPID pair.
# That is deliberate: discovering a missing key at the first send is
# discovering it hours later, from a feature whose only symptom is silence.
NUDGE_ENABLED="false"

# VAPID identity (RFC 8292). Generate a pair with:
#     npx web-push generate-vapid-keys
#
# The PUBLIC key is baked into every subscription made with it. Changing it
# does NOT re-key existing subscriptions — it silently invalidates all of
# them, and recovery means every browser visiting the site and subscribing
# again. Treat rotation as a migration, not a config tweak.
VAPID_PUBLIC_KEY=""
# SECRET. No working default on purpose. .gitignore already covers *.pem and
# .env; keep the key out of the repository.
VAPID_PRIVATE_KEY=""
# Identifies the sender to the push service. mailto: or an https: URL.
# Services reject or deprioritise senders without one.
VAPID_SUBJECT="mailto:you@example.com"

# IANA timezone deciding when a day starts and when quiet hours apply.
# Containers are UTC unless told otherwise, and a UTC day boundary is how an
# evening reminder arrives at 3am. Leaving this unset is allowed; it is logged
# loudly at startup rather than assumed.
NUDGE_TIMEZONE="America/Denver"

# Local hours, 0-23. The range may wrap midnight (22 -> 8 is the default).
# Equal bounds mean NO quiet hours, not permanent silence.
NUDGE_QUIET_HOURS_START="22"
NUDGE_QUIET_HOURS_END="8"

# How often the waker picks up work the engine already decided.
#
# NOT a schedule. Eligibility instants are solved when signals arrive and
# written to an indexed column; this is only the resolution at which they are
# noticed. Shortening it lands interventions closer to their computed instant
# and does not change which ones happen. The refractory floor and the decay
# half-lives are in crates/study_domain/src/calibration.rs, which is where
# "how often does someone hear from us" actually lives.
NUDGE_WAKER_SECONDS="300"

# How recently a dashboard WebSocket must have been active to count as someone
# being present. A pinned background tab holds its socket open all day, so this
# bound is what stops a forgotten tab from silencing the feature forever.
NUDGE_PRESENCE_FRESHNESS_SECONDS="120"

# Base URL of the study app. MUST end with a slash: the notification deep link
# is `${APP_BASE_URL}sessions/${id}`, matching the shape the client builds, and
# getting it wrong lands clicks on the dashboard instead of the session.
APP_BASE_URL="https://nixos.local:5173/"
