# file_host from source on the dev host: `make dev` (`cargo run`, beside
# home's container) exports this file, a variable already in the environment
# winning, so `FOO=bar make dev` overrides one value for one run. Every
# "ours" variable of infra/env/file_host.json is decided here (CFG9, #604);
# the checkout's .env adds secrets and neutral overrides, as on home.
#
# Its own state, so a dev run never shares home's: its own database (migrate
# it first, README.md, "Development"), every feature that acts on its own off
# (no second nudge waker, no second mailbox reader), and the compose stack's
# NATS and Redis, which publish on this machine.
#
# `#unset NAME` states that NAME is deliberately left unset. `make deploy-check`
# holds this file to the schema.

# ── Server ──

ALLOWED_ORIGINS=https://dev.home.maishatu.com,https://localhost:5173
REDIS_URL=redis://localhost:6379
DATABASE_URL=sqlite://dev.db

# ── Study nudge ──

NUDGE_ENABLED=false
#unset VAPID_PUBLIC_KEY
VAPID_SUBJECT=mailto:admin@maishatu.com
NUDGE_TIMEZONE=America/Denver
NUDGE_QUIET_HOURS_START=22
NUDGE_QUIET_HOURS_END=8
RECOMMENDER_USES_OUTCOMES=false
APP_BASE_URL=https://dev.home.maishatu.com/

# ── Passkey auth ──

# Off: a dev run's own database holds no account, and passkeys are bound to
# home's relying party.
AUTH_ENABLED=false
#unset WEBAUTHN_RP_ID
#unset WEBAUTHN_ORIGINS
AUTH_SESSION_DAYS=30
AUTH_OPEN_SIGNUP=false
AUTH_NEW_ACCOUNTS_PER_DAY=100

# ── Jobs mailbox ──

MAILBOX_ENABLED=false
ROUTINE_SCHEDULE="jobs 07:52 America/Los_Angeles; reflections 09:00 America/Los_Angeles"
MAILBOX_ARCHIVE_DAYS=90

# ── Jobs arrival notice ──

#unset FCM_SERVICE_ACCOUNT_FILE

# ── Voice-note transcription ──

TRANSCRIBE_ENABLED=false
TRANSCRIBE_MODEL=/models/ggml-small-q5_1.bin

# ── Rust Rounds recording ──

RUST_ROUNDS_ENABLED=false

# ── NFL game feed ──

GAME_FEED_ENABLED=false

# ── NATS ──

NATS_URL=nats://localhost:4222

# ── Tracing ──

ENVIRONMENT=development
