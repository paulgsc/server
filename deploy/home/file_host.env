# file_host on home, the box (DEPLOY=home in its .env): every "ours" variable
# of infra/env/file_host.json, its value decided here, in the PR that needs it
# (CFG9, #604). Compose reads this file into the file-host container
# (infra/compose/file_host.yml); the box's .env holds only secrets and neutral
# overrides, and the preflight refuses an "ours" value there.
#
# DATABASE_URL, NATS_URL and REDIS_URL are not here: they are compose's own
# network, set in the service's `environment:`.
#
# `#unset NAME` states that NAME is deliberately left unset. `make deploy-check`
# (Lint's Env schema job) holds this file to the schema.

# ── Server ──

# The study app (www) and `vite dev` (dev), as paulgsc/dotfiles'
# nixos/subdomains serves them on home.maishatu.com.
ALLOWED_ORIGINS=https://www.home.maishatu.com,https://dev.home.maishatu.com

# ── Study nudge ──

NUDGE_ENABLED=true
# WAITS ON THE OWNER: VAPID_PUBLIC_KEY, the public half of the pair the box's
# .env holds (VAPID_PRIVATE_KEY). Public by design, and only the box has it.
VAPID_SUBJECT=mailto:admin@maishatu.com
NUDGE_TIMEZONE=America/Denver
NUDGE_QUIET_HOURS_START=22
NUDGE_QUIET_HOURS_END=8
RECOMMENDER_USES_OUTCOMES=false
APP_BASE_URL=https://www.home.maishatu.com/

# ── Passkey auth ──

AUTH_ENABLED=true
# WAITS ON THE OWNER: WEBAUTHN_RP_ID, exactly the one home's passkeys were
# made under (home.maishatu.com, or www.home.maishatu.com?). A different one
# strands every passkey (README.md, "Host-specific values").
WEBAUTHN_ORIGINS=https://www.home.maishatu.com,https://dev.home.maishatu.com
AUTH_SESSION_DAYS=30
AUTH_OPEN_SIGNUP=false
AUTH_NEW_ACCOUNTS_PER_DAY=100
# With AUTH_OPEN_SIGNUP off, the owner's account is the operator.
#unset OPERATOR_SUBJECTS

# ── Jobs mailbox ──

MAILBOX_ENABLED=true
# The some-ui-mailbox Worker on the owner's Cloudflare account.
MAILBOX_URL=https://some-ui-mailbox.aulgondu.workers.dev
# With AUTH_OPEN_SIGNUP off, the owner's account.
#unset MAILBOX_SUBJECT
ROUTINE_SCHEDULE="jobs 07:52 America/Los_Angeles; reflections 09:00 America/Los_Angeles"
MAILBOX_ARCHIVE_DAYS=90

# ── Jobs arrival notice ──

# WAITS ON THE OWNER: FCM_SERVICE_ACCOUNT_FILE, the key's path inside the
# container if home notifies phones, or `#unset FCM_SERVICE_ACCOUNT_FILE`.

# ── Voice-note transcription ──

TRANSCRIBE_ENABLED=true
TRANSCRIBE_MODEL=/models/ggml-small-q5_1.bin

# ── Rust Rounds recording ──

# WAITS ON THE OWNER: RUST_ROUNDS_ENABLED, true or false.

# ── NFL game feed ──

# WAITS ON THE OWNER: GAME_FEED_ENABLED, true or false.

# ── Tracing ──

ENVIRONMENT=production
