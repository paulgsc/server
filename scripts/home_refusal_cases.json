{
  "_doc": "What `envctl compose --role home` refuses and lets through (RELEASE R6, #795; docs/release.md, RL12). One file for both readings of the rule: apps/envctl/src/compose.rs `home_refusal`'s test and scripts/check_home_guard.py's self-test read it, so the two cannot drift apart. Each entry is the words after `docker compose`.",
  "refused": [
    "pull",
    "pull rust-runner",
    "build",
    "build render",
    "watch",
    "up --build",
    "up --build=true",
    "up -d --build render",
    "up --watch",
    "up -w",
    "up -dw",
    "up -d -w",
    "up -d render",
    "up render kokoro",
    "up -- render",
    "up --timeout 30 render",
    "-p x pull",
    "-f docker-compose.yml pull",
    "-fother.yml up -d",
    "--file=other.yml ps",
    "--project-directory /elsewhere up -d",
    "--project-directory=/elsewhere ps",
    "--profile=tools build",
    "--profile tools up -d render",
    "run --build --rm render true",
    "run --build=true render",
    "run -e X=1 --build render true",
    "run -dv x:y --build render",
    "create --build",
    "create --build render"
  ],
  "allowed": [
    "",
    "ps",
    "logs -f render",
    "logs -f backup",
    "exec render sh",
    "exec render node cli.js --build",
