    "run --rm --no-deps render true",
    "run --rm --no-deps -v /a:/b -w /opt --entrypoint node render src/cli.ts --prove",
    "run --rm render node cli.js --build",
    "run --rm -w /opt render tool --build=x",
    "run --rm setup x --build",
    "up -d",
    "up",
    "up -dt 10",
    "up --build=false -d",
    "up --build=0 -d",
    "up --timeout 30 -d",
    "up --pull never -d",
    "up -d --no-build",
    "up -d --wait",
    "restart render",
    "down",
    "config",
    "-p x ps",
    "--profile tools ps"
  ]
}
