diff --git a/.github/workflows/resume-docker-release.yml b/.github/workflows/resume-docker-release.yml
index 22d903f6..2e640e0e 100644
--- a/.github/workflows/resume-docker-release.yml
+++ b/.github/workflows/resume-docker-release.yml
@@ -41,6 +41,27 @@ jobs:
             --label "org.opencontainers.image.revision=$GITHUB_SHA" \
             --tag resume-render:proof \
             packages/ui/resume
+      # The labels server's release check reads (paulgsc/server#853), in the
+      # form its scripts/check_release.py parses, so a malformed one is refused
+      # here rather than by the release.
+      - name: Check the release labels
+        run: |
+          set -euo pipefail
+          pair='[a-z0-9][a-z0-9-]*=([0-9]+|[0-9a-f]{40})'
+          edges=''
+          for key in io.paulgsc.provides io.paulgsc.requires; do
+            value=$(docker inspect --format "{{ index .Config.Labels \"$key\" }}" resume-render:proof)
+            echo "$key=$value"
+            if [ -n "$value" ] && ! [[ "$value" =~ ^$pair(,$pair)*$ ]]; then
+              echo "::error::$key is malformed: $value"
+              exit 1
+            fi
+            [ "$key" = io.paulgsc.provides ] && edges="$value"
+          done
+          if ! [[ ",$edges," =~ ,resume-api=[0-9]+, ]]; then
+            echo "::error::io.paulgsc.provides names no resume-api epoch"
+            exit 1
+          fi
       # The faux PII is the worst case `pnpm build` already proves every layout
       # with (scripts/fixtures/faux-pii.json). The request goes from inside the
       # container, since with no network nothing outside can reach its port.
diff --git a/.github/workflows/www-docker-release.yml b/.github/workflows/www-docker-release.yml
index 72c1b172..b8e5b9c2 100644
--- a/.github/workflows/www-docker-release.yml
+++ b/.github/workflows/www-docker-release.yml
@@ -180,6 +180,27 @@ jobs:
           push: false
           cache-from: type=gha
           tags: www:serve-check
+      # The labels server's release check reads (paulgsc/server#853), in the
+      # form its scripts/check_release.py parses, so a malformed one is refused
+      # here rather than by the release.
+      - name: Check the release labels
+        run: |
+          set -euo pipefail
+          pair='[a-z0-9][a-z0-9-]*=([0-9]+|[0-9a-f]{40})'
+          edges=''
+          for key in io.paulgsc.provides io.paulgsc.requires; do
+            value=$(docker inspect --format "{{ index .Config.Labels \"$key\" }}" www:serve-check)
+            echo "$key=$value"
+            if [ -n "$value" ] && ! [[ "$value" =~ ^$pair(,$pair)*$ ]]; then
+              echo "::error::$key is malformed: $value"
+              exit 1
+            fi
+            [ "$key" = io.paulgsc.requires ] && edges="$value"
+          done
+          if ! [[ ",$edges," =~ ,resume-api=[0-9]+, ]]; then
+            echo "::error::io.paulgsc.requires names no resume-api epoch"
+            exit 1
+          fi
       - name: Serve the image bare (WI1)
         run: |
           docker run -d --name www-serve-check -p 8080:80 www:serve-check
diff --git a/apps/www/Dockerfile b/apps/www/Dockerfile
index 919a1bda..cf7a4cd5 100644
--- a/apps/www/Dockerfile
+++ b/apps/www/Dockerfile
@@ -195,3 +195,13 @@ HEALTHCHECK --interval=30s \
     CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/ || exit 1
 
 CMD ["nginx", "-g", "daemon off;"]
+
+#
+# What paulgsc/server's release check reads (its scripts/check_release.py,
+# docs/release.md "Constraints"), last, so no layer depends on them.
+# - resume-api: the résumé service's API this build's /resume-build page
+#   calls through /api/resume/ (packages/ui/resume/Dockerfile provides it).
+# file_host's contract is not a label: the app asks home's /compat itself.
+#
+LABEL io.paulgsc.provides="" \
+      io.paulgsc.requires="resume-api=1"
